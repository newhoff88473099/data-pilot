# Copie este arquivo para ".env" e preencha a sua chave.
# O ".env" é ignorado pelo Git: nunca suba a sua chave para o GitHub.

# Chave criada em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo usado no chat. "openrouter/free" escolhe um modelo gratuito.
# Se trocar por outro, confira no OpenRouter se ele suporta chamada de ferramentas (tools).
OPENROUTER_MODEL=
